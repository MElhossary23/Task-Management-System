    {
      "name": "Tasks",
      "item": [
        {
          "name": "Create Task",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Task 1\",\n  \"description\": \"Task description\",\n  \"status\": \"To Do\",\n  \"assignedTo\": \"{{userId}}\",\n  \"dueDate\": \"2026-10-10\"\n}"
            },
            "url": {
              "raw": "http://localhost:5000/api/lists/{{listId}}/tasks",
              "protocol": "http",
              "host": ["localhost"],
              "port": "5000",
